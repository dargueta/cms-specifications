# SPDX-License-Identifier: BSD-3-Clause
$schema: https://datapackage.org/profiles/2.0/tableschema.json
fieldsMatch: [subset]
fields:
  - !beneficiary-identifier
  - name: surname
    title: Surname
    type: string
    constraints:
      maxLength: 12
      required: true
  - name: first_name
    title: First Name
    type: string
    constraints:
      maxLength: 7
      required: true
  - name: middle_initial
    title: Middle Initial
    type: string
    constraints:
      maxLength: 1
  - !sex-code
    name: sex
    title: Sex
    constraints:
      required: true
  - !date8
    name: birth_date
    title: Birth Date
    constraints:
      required: true
{% if enable_eghp_flag_field %}
  - !bool-yn
    name: eghp_flag
{% else %}
  - !filler 1
{% endif %}
  - name: pbp_number
    title: "PBP #"
    description: Not required but must be valid for the contract when provided.
    type: string
    constraints:
      maxLength: 3
  - !plan-election-type
    name: election_type
    title: Election Type
    description: >-
      Required for all Plan types except HCPP, COST 1 without drug, COST 2
      without drug, CCIP/FFS demo, MDHO demo, MSHO demo, and PACE National Plans.

      * MAs have A, D, I, L[^retronote], M, N, O, S, T, U, V, W, X.
      * MAPDs have A, D, E, I, L[^retronote], M, N, O, S, T, U, V, W, X, Z.
      * PDPs have A, E, L[^retronote], S, U, V, W, X, Z.

      [^retronote]: For RPC Retroactive transactions only effective 1/1/2025. Plan
      disenrollment transactions after 1/1/2025 will reject.
  - name: contract_number
    title: "Contract #"
    type: string
    constraints:
      maxLength: 5
      required: true
{% if enable_application_date_field %}
  - !date8
    name: application_date
    title: Application Date
    constraints:
      required: true
{% else %}
  - !filler 8
{% endif %}
  - name: transaction_code
    type: string
    constraints:
      enum: {{ transaction_code_enum }}
      required: true
    __metadata__:
      deserialization:
        is_record_type_id: true
{% if enable_disenrollment_reason_code_field %}
  - !special-election-period-code
    name: disenrollment_reason_code
    title: Disenrollment Reason Code
    description: >-
      Required for Involuntary Disenrollments. Optional for Voluntary Disenrollments.
{% else %}
  - !filler 2
{% endif %}
  - !date8
    name: effective_date
    title: Effective Date
    constraints:
      required: true
  - name: segment_id
    title: Segment ID
    description: Optional 3 digits for segmented organizations otherwise, blank.
    type: string
    constraints:
      maxLength: 3
  - !filler 5
{% if enable_esrd_override_field %}
  - name: esrd_override
    title: ESRD Override
    type: string
    constraints:
      maxLength: 1
      # TODO (dargueta): Make this an enum.
      pattern: "[0-9A-F]"
{% else %}
  - !filler 1
{% endif %}
{% if enable_premium_withhold_option_field %}
  - name: premium_withhold_option
    title: Premium Withhold Option/Parts C-D
    description: >-
      Required for all plan types except HCPP, COST 1 without drug, COST 2
      without drug, CCIP/FFS demo, MSA/MA and MSA/demo plans.
    type: string
    constraints:
      maxLength: 1
{%else %}
  - !filler 1
{% endif %}
{% if enable_part_c_premium_amount_field %}
  - name: part_c_premium_amount
    title: Part C Premium Amount (XXXXvXX)
    description: >-
      Required for all plan types except HCPP, COST 1, COST 2, CCIP/FFS demo,
      MSA/MA and MSA/demo plans.

      Interpret a blank field as a zero value.
    type: numeric
    decimalChar: ""  # The decimal is implied at 2 digits.
    constraints:
      maxLength: 6
    __metadata__:
      serialization:
        implied_decimal_at: 2
      deserialization:
        implied_decimal_at: 2
{% else %}
  - !filler 6
{% endif %}
{% if enable_creditable_coverage_flag_field %}
  - !bool-yn
    name: creditable_coverage_flag
    title: Creditable Coverage Flag
    description: >-
      'Y' or 'N' for all Part D plans; otherwise, blank.
{% else %}
  - !filler 1
{% endif %}
{% if enable_number_of_uncovered_months_field %}
  - name: number_of_uncovered_months
    title: Number of Uncovered Months
    type: integer
    constraints:
      maxLength: 3
      minimum: 0
      maximum: 999
{% else %}
  - !filler 3
{% endif %}
{% if enable_employer_subsidy_enrollment_override_flag_field %}
  - !bool-yn
    name: employer_subsidy_enrollment_override_flag
    title: Employer Subsidy Enrollment Override
    description: >-
      'Y' if beneficiary has Employer Subsidy status for Part D; otherwise, blank.
{% else %}
  - fill! 1
{% endif %}
  ### BUG! | Expectation is fill of 11 characters but there are no more fields
  ### BUG! | here.
  - !bool-yn
    name: part_d_opt_out_flag
    title: Part D Opt-Out Flag
    description: >-
      Disenrollment: Optional for all Part D Plans; otherwise blank.

      Enrollment only: Required when changing PBPs. ('Y' when Opting Out of Part
      D; 'N' when Opting in to Part D; otherwise, blank)
{% if enable_mmp_opt_out_flag_field %}
  - !bool-yn
    name: mmp_opt_out_flag
    title: MMP Opt-Out Flag
{% else %}
  - !filler 1
{% endif %}
  - !plan-election-type
    name: sep_reason_code
    title: Election Type/SEP Reason Code
  - !filler 107
  - name: plan_transaction_tracking_id
    title: Plan Transaction Tracking ID
    type: string
    constraints:
      maxLength: 15
  - !filler 76
